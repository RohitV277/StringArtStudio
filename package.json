{
  "name": "string-art-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline string art designer for iPad and iPhone. Designs stay on the device.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:catalog": "node scripts/verify-catalog.mjs",
    "test:qa": "node scripts/run-qa.mjs",
    "benchmark": "node benchmarks/nails-benchmark.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "ios:add": "cap add ios",
    "ios:assets": "capacitor-assets generate --ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  },
  "engines": { "node": ">=20" }
}
